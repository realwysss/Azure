{
  "schemaVersion": 1,
  "id": "azure",
  "version": "${version}",
  "name": "Azure",
  "description": "azure, the wysss client. a custom client with smooth menus, hud framework and themes. modules are added one at a time. needs Wysss Lib (key RIGHT SHIFT).",
  "authors": [
    "wysss"
  ],
  "contact": {
    "sources": "https://github.com/realwysss/Azure"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/azure/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.wscl.Wc",
      "dev.angl.AnGl",
      "dev.blrb.BlurClient",
      "dev.cropt.CoClient",
      "hits.fire.Glow",
      "dev.frbs.FrBs",
      "dev.frtr.FrTr",
      "dev.glib.Gl",
      "dev.itop.Itop",
      "dev.klfx.KlfxClnt",
      "dev.nobn.NoBn",
      "dev.noeb.NoebClient",
      "dev.ogfg.OgFg",
      "dev.oldp.OldP",
      "dev.tpgl.TpGl",
      "dev.htcl.HtCl",
      "dev.htgl.HtGl",
      "dev.crgl.CrGl",
      "dev.xpgl.XpGl"
    ],
    "main": [
      "dev.cropt.CoMain"
    ]
  },
  "mixins": [
    "azure.mixins.json",
    "anchorglow.client.mixins.json",
    "blurreborn.client.mixins.json",
    "crystalopt.client.mixins.json",
    "fireglow.mixins.json",
    "frameboost.client.mixins.json",
    "frametrim.client.mixins.json",
    "itemsopacity.client.mixins.json",
    "nobounce.client.mixins.json",
    "noeb.client.mixins.json",
    "ogfog.client.mixins.json",
    "oldpotions.client.mixins.json",
    "totemparticleglow.client.mixins.json",
    "tuffbright.client.mixins.json",
    "hitcolor.client.mixins.json",
    "hitglow.client.mixins.json",
    "crystalglow.client.mixins.json",
    "xpglow.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  },
  "jars": [
    {
      "file": "META-INF/jars/nuit.jar"
    },
    {
      "file": "META-INF/jars/nuit-interop.jar"
    },
    {
      "file": "META-INF/jars/wysss-lib.jar"
    }
  ]
}