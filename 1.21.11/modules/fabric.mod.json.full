{
  "schemaVersion": 1,
  "id": "azure",
  "version": "${version}",
  "name": "Azure",
  "description": "azure, the wysss client: every wysss mod in one jar with a custom hud, crosshair, textures, sounds and menus. needs Wysss Lib (key RIGHT SHIFT).",
  "authors": [
    "wysss"
  ],
  "contact": {
    "sources": "https://github.com/realwysss/Azure"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/azure/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.wscl.Wc",
      "dev.angl.AnGl",
      "dev.blrb.BlurClient",
      "dev.crgl.CrGl",
      "dev.cropt.CoClient",
      "hits.fire.Glow",
      "dev.frbs.FrBs",
      "dev.frtr.FrTr",
      "dev.glib.Gl",
      "dev.htcl.HtCl",
      "dev.htgl.HtGl",
      "dev.itop.Itop",
      "dev.klfx.KlfxClnt",
      "dev.nobn.NoBn",
      "dev.noeb.NoebClient",
      "dev.ogfg.OgFg",
      "dev.oldp.OldP",
      "dev.tpgl.TpGl",
      "dev.tfbr.TfbrClient",
      "dev.tfgl.TfGl",
      "dev.xpgl.XpGl"
    ],
    "main": [
      "dev.cropt.CoMain"
    ]
  },
  "mixins": [
    "azure.mixins.json",
    "anchorglow.client.mixins.json",
    "blurreborn.client.mixins.json",
    "crystalglow.client.mixins.json",
    "crystalopt.client.mixins.json",
    "fireglow.mixins.json",
    "frameboost.client.mixins.json",
    "frametrim.client.mixins.json",
    "hitcolor.client.mixins.json",
    "hitglow.client.mixins.json",
    "itemsopacity.client.mixins.json",
    "nobounce.client.mixins.json",
    "noeb.client.mixins.json",
    "nohotbarname.client.mixins.json",
    "noswiftnessfov.client.mixins.json",
    "ogfog.client.mixins.json",
    "oldpotions.client.mixins.json",
    "packblocker.client.mixins.json",
    "totemparticleglow.client.mixins.json",
    "tuffbright.client.mixins.json",
    "tuffglint.client.mixins.json",
    "xpglow.client.mixins.json"
  ],
  "provides": [
    "anchorglow",
    "blurreborn",
    "crystalglow",
    "crystalopt",
    "fireglow",
    "frameboost",
    "frametrim",
    "glowlib",
    "hitcolor",
    "hitglow",
    "itemsopacity",
    "klfx",
    "nobounce",
    "noeb",
    "nohotbarname",
    "noslownessfov",
    "noswiftnessfov",
    "ogfog",
    "oldpotions",
    "packblocker",
    "totemparticleglow",
    "tuffbright",
    "tuffglint",
    "xpglow"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "wysslib": ">=1.1.0",
    "minecraft": "1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}